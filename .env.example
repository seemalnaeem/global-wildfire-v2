# Copy to .env. Values here are safe local defaults, change for anything shared.

# Database (PostGIS)
POSTGRES_DB=global-wildfire
POSTGRES_USER=gwf
POSTGRES_PASSWORD=gwf
# Host connection string for tools run outside Docker.
DATABASE_URL=postgres://gwf:gwf@172.18.1.60:5440/global-wildfire

# Service ports (fixed by convention, see CLAUDE.md)
BACKEND_PORT=3040
GEOPROCESSING_PORT=3041
TITILER_PORT=3042
FRONTEND_PORT=5180

# Frontend build-time URLs
VITE_BACKEND_URL=http://172.18.1.60:3040
VITE_TITILER_URL=http://172.18.1.60:3042
# Mapbox basemap token (public pk.* token, exposed to the browser). Leave empty
# to fall back to a plain dark background with no basemap.
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Geoprocessing

DATA_DIR=./data

# Ingestion framework (Phase 1)
# Object storage backend: 'local' now, 's3' when MinIO is added.
STORAGE_BACKEND=local
# Embedded APScheduler. Set true to auto-refresh fire data so the 24/48/72h filters
# stay current. It prunes detections older than FIRMS_RETENTION_DAYS, pulls fresh
# FIRMS, re-clusters, enriches, and classifies every FIRMS_REFRESH_HOURS.
SCHEDULER_ENABLED=false
FIRMS_REFRESH_HOURS=6
FIRMS_RETENTION_DAYS=5

# NASA FIRMS / VIIRS connector (Phase 2). Without a key it runs in sample mode.
# Free key: https://firms.modaps.eosdis.nasa.gov/
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT
# 'world' or a bounding box 'west,south,east,north'. Start bounded, not world.
FIRMS_AREA=world
FIRMS_DAYS=1

# FIRMS point filter: keep detections with FRP strictly greater than this.
FIRMS_MIN_FRP=2

# Event formation (FIRMS_point_filtering.md). A dense knot of detections becomes an
# event only if it clears all: DBSCAN density (radius + min points) and combined FRP.
# DBSCAN can split one fire, so neighbours within the merge distance are merged.
FIRE_CLUSTER_DISTANCE_M=1000
FIRE_CLUSTER_MIN_POINTS=5
FIRE_MIN_CLUSTER_FRP=20
FIRE_MERGE_DISTANCE_M=2500

# Wildfire classification: an event is a wildfire if its land cover is wildland.
# WorldCover codes: 10 tree, 20 shrub, 30 grass, 40 crop, 50 built, 60 bare,
# 70 snow, 80 water, 90 wetland, 95 mangrove, 100 moss.
WILDFIRE_LANDCOVER_CODES=10,20,30

# Copernicus Data Space (Sentinel-2 vegetation indices NDVI/NDMI/NBR).
# Create a Sentinel Hub OAuth client at https://dataspace.copernicus.eu/.
# Kept in .env only, never committed.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
